# PTF v33.0.0 API baseline — deny by default
<IfModule mod_rewrite.c>
  RewriteEngine On

  # v34.0.7-alpha: attachment-read.php و chat-llm.php دوباره فعال شدند — هرکدام
  # اکنون گارد احراز/منشأ خود را دارند (SEC-01 و باگ‌های پروداکشن AI/ضمیمه).
  # بقیهٔ سرویس‌ها همچنان غیرفعال‌اند تا کار احراز سطح‌رکورد کامل شود.
  RewriteRule ^(?:notify-bot|tech-proposal-docx|tools)\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "\.(?:php|json|log|txt)$">
  <If "%{REQUEST_URI} =~ m#/(crm|contact|codegen|fx-rates|storage|cms|auth|llm|attachment-thumb|attachment-read|chat-llm)\.php$#">
    Require all granted
  </If>
  <Else>
    Require all denied
  </Else>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
</IfModule>
