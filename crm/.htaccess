Options -Indexes

<Files "storage.php">
  Require all denied
</Files>

# ---------------------------------------------------------------------------
# PTF CRM — v34.38.18-02 (CACHE-HOTFIX — گزارش کارفرما: «پردهٔ آماده‌سازی بوت
# روی موبایل می‌آید ولی روی دسکتاپ نه»).
#
# ریشهٔ باگ (سه حلقهٔ زنجیره):
#  ۱) قانون SEO-PERF سایتِ عمومی در .htaccess ریشه، همهٔ *.js را «۳۰ روز» پین
#     می‌کند (Header set Cache-Control public,max-age=2592000 + ExpiresByType).
#  ۲) کوئری نسخهٔ اسکریپت‌های CRM (?v=34.38.16) در چند پاتچ پیاپی بدون بامپ ماند،
#     درحالی‌که محتوای همان URL عوض شد (مثلاً sync.js در PR #۲۷ به‌میزان +۲۱/-۲
#     خط تغییر کرد ولی URL ثابت ماند) ⇒ مرورگری که همان URL را به‌تازگی کش کرده،
#     تا ۳۰ روز نسخهٔ کهنه را «بدون هیچ revalidate‌ای» اجرا می‌کند (حتی با F5).
#  ۳) روی index.html هیچ هدر کش صریحی نیست ⇒ مرورگر با Last-Modified heuristic
#     گاهی نمای HTML قدیمی را در ناوبریِ معمولی (بدون F5) سرو می‌کند.
#  نتیجهٔ مشاهده‌شده: دسکتاپ با پروفایل/کش چندروزه، اسناد قدیمی را اجرا می‌کرد؛
#  موبایل (اپ TWA/پروفایل تازه) همه‌چیز را پس از دیپلوی تازه گرفت ⇒ «روی موبایل
#  می‌آید، روی دسکتاپ نه».
#
# اصلاح: زیردرخت CRM از پین بلندمدت mod_expires مستثنا و با revalidate اجباری
# سرو می‌شود (ETag هزینهٔ 304 را ناچیز می‌کند). سیاست کش ۳۰روزهٔ سایتِ عمومی
# (SEO/پرفرمنس) دست‌نخورده می‌ماند — این بلوک فقط روی /crm/اثر دارد.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|js|css|json|webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set Pragma "no-cache"
  </FilesMatch>
</IfModule>
