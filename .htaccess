# PTF v33.0.0 — production/staging public-root baseline
Options -Indexes

# SEO: custom 404 page
ErrorDocument 404 /404.html

# SEO: canonical supplier hub (legacy /tamin-tajhizat/ -> /suppliers/)
RewriteRule ^tamin-tajhizat/?$ /suppliers/ [R=301,L]

<FilesMatch "^(?!manifest\.json$).*\.(?:json|log|zip|gz|bak|sql|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(?:error_log|php_errorlog)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # SEC-04 (v34.1): CSP — مسدودسازی بارگذاری منابع خارجی (unsafe-inline لازم است چون ۸۰+ onclick/style inline وجود دارد)
  # v34.9.1: دامنه‌های Google Analytics 4 مجاز شدند (بدون آن‌ها مرورگر gtag را بلاک می‌کرد).
  # v34.4.44: PDF امن از attachment-read به Blob URL تبدیل و داخل iframe نمایش داده می‌شود؛
  # default-src 'self' به‌تنهایی blob: را برای frame نمی‌پذیرفت و فقط «تب جدید» کار می‌کرد.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://*.arvancloud.ir https://*.arvanstorage.ir https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'self' blob:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
</IfModule>

# Canonical HTTPS redirect for the production hostname only.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?pishtaj\.ir$ [NC]
RewriteRule ^ https://pishtaj.ir%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------
# SEO-2026-08-30 (BUG-SEO-WWW-001): یکسان‌سازی میزبان روی HTTPS
# قانون بالا فقط وقتی HTTPS خاموش بود اجرا می‌شد؛ در نتیجه
# https://www.pishtaj.ir با کد ۲۰۰ و محتوای کاملِ تکراری سرو می‌شد
# (گوگل هر دو میزبان را ایندکس کرده بود → تقسیم اعتبار دامنه).
# این قانون برای درخواست‌های HTTPS هم www را به نود دامنه ۳۰۱ می‌دهد.
# ------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.pishtaj\.ir$ [NC]
RewriteRule ^ https://pishtaj.ir%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------
# SEO-2026-08-30 (BUG-SEO-SPAM-410): URLهای اسپم تزریقیِ دوران وردپرس
# (کازینو/شرط‌بندی عربی). این مسیرها الان ۴۰۴ هستند و در فهرست گوگل
# مانده‌اند؛ ۴۱۰ (Gone) سیگنالِ حذفِ قوی‌تر و سریع‌تری از ۴۰۴ است.
# فقط کلیدواژه‌های بی‌خطرِ اختصاصیِ اسپم — نه واژه‌های عمومی فارسی.
# ------------------------------------------------------------------
RewriteCond %{REQUEST_URI} (casino|paysafecard|bingo|مراهنات|مراهنة|مراهنه) [NC]
RewriteRule ^ - [G,L]

# v34.7.51: صفحه آگهی از jobs.json اگر فایل استاتیک ساخته نشده باشد
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^careers/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ /careers/view.php?slug=$1 [L,QSA]

# ------------------------------------------------------------------
# SEO-2026-08-30 (BUG-SEO-DUP-301): صفحات تکراری/کم‌حجم که تا امروز فقط با
# canonical سرپوش گذاشته شده بودند. canonical به‌تنهایی اعتبار را منتقل نمی‌کند
# و خزش را هدر می‌دهد؛ ریدایرکت ۳۰۱ سیگنال قطعی است و مقصدها واقعاً قوی‌ترند:
#   یکتای مبدأ در برابر مقصد: ۳۳۶→۱۶۹۸ | ۲۸۹→۶۸۹ | ۲۱۵→۱۱۰۴ | ۲۰۵→۱۵۰۷ | ۹۹→۷۶۶ | ۱۴۶→۶۱۲
# ------------------------------------------------------------------
# Canonical targets are the substantive *.html pages. Do not redirect them to
# the legacy thin stubs below; those stubs point back here and create a redirect
# loop (or a 200 meta-refresh page) for crawlers and users.
RewriteRule ^knowledge-center/article-012\.html$ /industries/steel/ [R=301,L]
RewriteRule ^knowledge-center/nace-mr0175\.html$ /knowledge-center/nace-mr0175-sour-service-guide.html [R=301,L]

# SEO-2026-08-31 (KC-CONSOLIDATION): 40 پوستهٔ مرکز دانش که برای یک موضوع،
# چند URL داشتیم. پوسته‌ها فقط خزش را هدر می‌دادند و با صفحهٔ اصلیِ همان
# موضوع رقابت می‌کردند. هر جفت با مقایسهٔ «متن یکتا» (پس از حذفِ قالبِ مشترک)
# تأیید شده و مقصد همیشه پر محتواتر است. فایلی حذف نشده است.
# ------------------------------------------------------------------
RewriteRule ^knowledge-center/api\-610\.html$ /knowledge-center/kc-api-610.html [R=301,L]
RewriteRule ^knowledge-center/api\-617\.html$ /knowledge-center/kc-api-617.html [R=301,L]
