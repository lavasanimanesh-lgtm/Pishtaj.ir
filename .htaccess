RewriteRule ^knowledge-center/a106\-pipe\-procurement\-guide\.html$ /knowledge-center/kc-astm-a106-gr.html [R=301,L]
RewriteRule ^knowledge-center/astm\-a53\-gr\-b\.html$ /knowledge-center/a53-pipe-specifications.html [R=301,L]
RewriteRule ^knowledge-center/a53\-gr\-b\.html$ /knowledge-center/a53-pipe-specifications.html [R=301,L]
RewriteRule ^knowledge-center/astm\-a335\-p91\.html$ /knowledge-center/kc-a335.html [R=301,L]
RewriteRule ^knowledge-center/astm\-a335\-p11\-p22\-p91\.html$ /knowledge-center/kc-a335.html [R=301,L]
RewriteRule ^knowledge-center/ball\-valve\-api\-6d\.html$ /knowledge-center/api-6d-ball-valve-standard.html [R=301,L]
