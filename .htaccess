# PTF v33.0.0 — production/staging public-root baseline
Options -Indexes

# SEO: custom 404 page
ErrorDocument 404 /404.html

<FilesMatch "^(?!manifest\.json$).*\.(?:json|log|zip|gz|bak|sql|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(?:error_log|php_errorlog)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # SEC-04 (v34.1): CSP — مسدودسازی بارگذاری منابع خارجی (unsafe-inline لازم است چون ۸۰+ onclick/style inline وجود دارد)
  # v34.4.44: PDF امن از attachment-read به Blob URL تبدیل و داخل iframe نمایش داده می‌شود؛
  # default-src 'self' به‌تنهایی blob: را برای frame نمی‌پذیرفت و فقط «تب جدید» کار می‌کرد.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.arvancloud.ir https://*.arvanstorage.ir; frame-src 'self' blob:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
</IfModule>

# Canonical HTTPS redirect for the production hostname only.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?pishtaj\.ir$ [NC]
RewriteRule ^ https://pishtaj.ir%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------
# SEO-CLEANUP-2026-07: قدیمی‌ترین نسخهٔ «تخت» این صفحات با نسخهٔ
# «پوشه‌ای» جدیدتر جایگزین شده بود ولی فایل قدیمی حذف نشده بود.
# این ریدایرکت ۳۰۱ تضمین می‌کند هر بک‌لینک/بوکمارک/نتیجهٔ قدیمی گوگل
# به آدرس درست هدایت شود (بدون از دست دادن اعتبار سئوی احتمالی).
# ------------------------------------------------------------------
