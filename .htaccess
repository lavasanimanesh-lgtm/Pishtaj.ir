# ------------------------------------------------------------------
# SEO-2026-08: یکسان‌سازی آدرس‌ها (URL Canonicalization)
# جلوگیری از محتوای تکراری با هدایت /path/index.html به /path/
# و حذف اسلش انتهایی تکراری. تگ canonical به‌تنهایی کافی نیست؛
# ریدایرکت ۳۰۱ سیگنال قطعی به گوگل می‌دهد و اعتبار را متمرکز می‌کند.
# ------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]
