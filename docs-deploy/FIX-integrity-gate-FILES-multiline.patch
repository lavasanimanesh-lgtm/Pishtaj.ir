diff --git a/.github/workflows/deploy-production.yml b/.github/workflows/deploy-production.yml
index 7f1780a..55bafe0 100644
--- a/.github/workflows/deploy-production.yml
+++ b/.github/workflows/deploy-production.yml
@@ -176,17 +176,44 @@ jobs:
       - name: Post-deploy integrity check
         run: |
           BASE="https://pishtaj.ir"
-          FILES="crm/index.html crm/sw.js crm/shell.js crm/client-server.js crm/key-registry.js crm/sales-domain-v2.js crm/manifest.json"
+          # ⚠ این فهرست باید «چندخطی» باشد (یک نام در هر خط). رشتهٔ یک‌خطیِ فاصله‌دار
+          #   با `while IFS= read -r f` فقط یک‌بار حلقه می‌زند و *کل* رشته را به‌عنوان
+          #   یک نام فایل می‌گیرد → sha1sum خطا می‌دهد (want تهی) و curl هم خطا می‌دهد
+          #   (got = هش ورودی تهی) → گیت بی‌قیدوشرط و برای همیشه قرمز می‌شود.
+          #   الگوی درست، همان BYTES_FILES در _tools/ci/verify-deploy.sh است.
+          FILES="crm/index.html
+          crm/sw.js
+          crm/shell.js
+          crm/client-server.js
+          crm/key-registry.js
+          crm/sales-domain-v2.js
+          crm/manifest.json"
           PTF_CRM_RELEASE="$(node -p "require('./VERSION.json').crm_version")"
           echo "کامیت: $DEPLOY_SHA | نسخهٔ مورد انتظار (VERSION.json → crm_version): $PTF_CRM_RELEASE"
+          LIVE_TMP=".live-integrity.tmp"
           fail=1
           for i in 1 2 3 4 5; do
             ok=1
             while IFS= read -r f; do
+              [ -z "$f" ] && continue
+              if [ ! -f "$f" ]; then ok=0; echo "   ≠ $f در کامیت وجود ندارد"; continue; fi
+              # دانلود در فایل موقت: هم بایت‌دقیق است و هم «خطای دریافت» را از
+              # «محتوای متفاوت» جدا می‌کند (وگرنه هر دو یکسان و بی‌توضیح دیده می‌شوند)
+              if ! curl -fsSL --max-time 30 "$BASE/$f?v=$(date +%s)" -o "$LIVE_TMP"; then
+                ok=0; echo "   ≠ $f: دریافت از سایت زنده ناموفق بود (HTTP/شبکه)"; continue
+              fi
               want="$(sha1sum "$f" | cut -d' ' -f1)"
-              got="$(curl -fsSL --max-time 30 "$BASE/$f?v=$(date +%s)" | sha1sum | cut -d' ' -f1)"
-              if [ "$want" != "$got" ]; then ok=0; echo "   ≠ $f (want=${want:0:10} got=${got:0:10})"; fi
+              got="$(sha1sum "$LIVE_TMP" | cut -d' ' -f1)"
+              if [ "$want" != "$got" ]; then
+                ok=0
+                w_norm="$(tr -d '\r' < "$f" | sha1sum | cut -d' ' -f1)"
+                g_norm="$(tr -d '\r' < "$LIVE_TMP" | sha1sum | cut -d' ' -f1)"
+                hint=""
+                [ "$w_norm" = "$g_norm" ] && hint=" — فقط تفاوت پایان‌خط (\r): سرور فایل را با تبدیل خط تحویل می‌دهد"
+                echo "   ≠ $f (want=${want:0:10} got=${got:0:10} | کامیت=$(wc -c < "$f") بایت، زنده=$(wc -c < "$LIVE_TMP") بایت)$hint"
+              fi
             done <<< "$FILES"
+            rm -f "$LIVE_TMP"
             live_sw="$(curl -fsSL --max-time 30 "$BASE/crm/sw.js?v=$(date +%s)" | grep -o "RELEASE = 'v[0-9.]*'" | head -1)"
             if [ "$live_sw" != "RELEASE = '$PTF_CRM_RELEASE'" ]; then ok=0; echo "   ≠ crm/sw.js زنده: $live_sw"; fi
             if [ "$ok" -eq 1 ]; then fail=0; echo "✅ تلاش $i: همهٔ فایل‌های حساس زنده == کامیت"; break; fi
