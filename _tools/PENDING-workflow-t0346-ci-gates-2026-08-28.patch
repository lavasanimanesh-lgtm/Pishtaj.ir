diff --git a/.github/workflows/deploy-staging.yml b/.github/workflows/deploy-staging.yml
index abee444..13f4eff 100644
--- a/.github/workflows/deploy-staging.yml
+++ b/.github/workflows/deploy-staging.yml
@@ -80,6 +80,37 @@ jobs:
           done < <(find api -name '*.php' -print0)
           if [ "$fail" -ne 0 ]; then echo "::error::حداقل یک فایل PHP سینتکس خراب دارد"; exit 1; fi
           echo "php -l: همهٔ فایل‌های api/*.php سالم"
+
+      # Node پایدار برای رانر گیت (H1: قرارداد «Setup Node» در هر دو workflow استقرار)
+      - name: Setup Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      # T0-3 (v34.8.35): گیت نازک‌سازی + نگهبان معماری — قبل از FTP.
+      # همهٔ تسترهای sync/مالی/نازک‌سازی (run-ci-gate) + arch-guard اینجا اجرا می‌شوند؛
+      # تا این مرحله سبز نشود هیچ فایلی روی استیجینگ نمی‌رود (جلوگیری از بازگشت بایپس‌ها).
+      - name: Thin-client CI gate + arch guard (pre-deploy)
+        run: |
+          node _tools/uat/run-ci-gate.js
+
+      # T0-6 (v34.8.35): هدر no-cache برای js/html فقط روی استیجینگ — جلوگیری از
+      # دیدن «نسخهٔ مخلوط» به‌خاطر کش مرورگر/CDN حین تست. این بلوک فقط در این workflow
+      # (که فقط روی استیجینگ می‌رود) به انتهای .htaccess تزریق می‌شود؛ پروداکشن دست‌نخورده.
+      - name: Staging-only no-cache headers for js/html
+        run: |
+          cat >> .htaccess <<'HTACCESS'
+
+          # ── T0-6 (v34.8.35): فقط استیجینگ — کش مرورگر/CDN برای js/html خاموش ──
+          <IfModule mod_headers.c>
+            <FilesMatch "\.(js|html)$">
+              Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
+              Header set Pragma "no-cache"
+            </FilesMatch>
+          </IfModule>
+          HTACCESS
+          echo "staging no-cache headers appended to .htaccess"
+
       - name: Deploy via FTP
         uses: SamKirkland/FTP-Deploy-Action@v4.3.5
         with:
@@ -105,6 +136,17 @@ jobs:
             tester*.js
             FILES-CHANGED-*.txt
 
+      # T0-4 (v34.8.35): گیت بعد از استقرار — هش ۵ فایل کلیدیِ زنده باید با همین
+      # کامیت یکی باشد؛ نابرابر (دیپلوی مخلوط/ناقص) = شکست استقرار با هشدار واضح.
+      # تا ۲ دقیقه برای انتشار کامل FTP/CDN retry می‌کند.
+      - name: Post-deploy hash check (mixed-version guard)
+        env:
+          BASE: https://staging.pishtaj.ir
+          TRIES: '12'
+          WAIT_MS: '10000'
