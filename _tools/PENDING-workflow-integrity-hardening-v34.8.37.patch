           FILES="crm/index.html crm/sw.js crm/shell.js crm/client-server.js crm/key-registry.js crm/sales-domain-v2.js crm/manifest.json"
           PTF_CRM_RELEASE="$(node -p "require('./VERSION.json').crm_version")"
