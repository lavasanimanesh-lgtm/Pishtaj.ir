               if [ "$want" != "$got" ]; then ok=0; echo "   ≠ $f (want=${want:0:10} got=${got:0:10})"; fi
             done <<< "$FILES"
-            live_sw="$(curl -fsSL --max-time 30 "$BASE/crm/sw.js?v=$(date +%s)" | grep -o "RELEASE = 'v[0-9.]*'" | head -1)"
+            live_sw="$(curl -fsSL --max-time 30 -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' "$BASE/crm/sw.js?v=$(date +%s)&r=$RANDOM" | grep -o "RELEASE = 'v[0-9.]*'" | head -1)"
             if [ "$live_sw" != "RELEASE = '$PTF_CRM_RELEASE'" ]; then ok=0; echo "   ≠ crm/sw.js زنده: $live_sw"; fi
             if [ "$ok" -eq 1 ]; then fail=0; echo "✅ تلاش $i: همهٔ فایل‌های حساس زنده == کامیت"; break; fi
-            echo "   … تلاش $i ناموفق؛ ۱۲ ثانیه صبر و تکرار"
-            sleep 12
+            echo "   … تلاش $i ناموفق؛ ۳۰ ثانیه صبر و تکرار (پنجرهٔ کل ~۹ دقیقه با انتظار اولیه)"
+            sleep 30
           done
           if [ "$fail" -ne 0 ]; then
             echo "::error::سایت زنده با کامیت دیپلوی‌شده یکی نیست — استقرار ناموفق اعلام می‌شود"
