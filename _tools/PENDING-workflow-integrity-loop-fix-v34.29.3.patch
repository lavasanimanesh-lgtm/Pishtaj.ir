# PENDING-workflow-integrity-loop-fix-v34.29.3.patch
# ─────────────────────────────────────────────────────────────────────────────
# چرا این وصله «معلق» است: GitHub App نشست Arena مجوز `workflows` ندارد و push هر
# تغییری در .github/workflows/* را رد می‌کند (refusing to allow a GitHub App to
# create or update workflow … without `workflows` permission). طبق قرارداد قبلیِ
# همین مخزن (PENDING-workflow-ci-gate / php-lint / speedup) مالک آن را اعمال می‌کند:
#
#   git apply _tools/PENDING-workflow-integrity-loop-fix-v34.29.3.patch
#   git commit -am "ci(deploy): fix Post-deploy integrity loop (for f in \$FILES)"
#
# ریشه (RCA از لاگ ران 33576133226؛ صفر ران سبز از ۲۰۲۶-۰۸-۲۸ تا امروز — ۶۰ ران):
#   while IFS= read -r f; do … done <<< "$FILES"
# با FILES فاصله‌دار، کل فهرست را «یک خط» می‌خواند →
#   sha1sum: 'crm/sw.js crm/shell.js …': No such file or directory
#   curl: (3) URL rejected: Malformed input to a URL function
# → want='' ≠ got=da39a3ee5e (sha1 رشتهٔ خالی) → گیت همیشه قرمز، مستقل از سلامت استقرار.
# در همان ران‌ها sw.js/manifest/مارکر زنده == کامیت بود (false-red).
#
# رفع: `for f in $FILES; do … done` (نام فایل‌ها فاصله ندارند) در هر دو ورک‌فلو.
# شبیه‌سازی آفلاین: live==commit → «✅ تلاش ۱»؛ یک فایل کهنه → «≠» و ::error.
#
# ترتیب اعمال با وصلهٔ speed-up: ابتدا این وصله، سپس
#   _tools/PENDING-workflow-deploy-staging-speedup-v34.8.40.patch
# (وصلهٔ speed-up روی ورک‌فلوی اصلاح‌شده بازتولید شده و همان باگ را در دو لایهٔ
#  readback/HTTP خودش تکرار نمی‌کند — tester540 هر دو را می‌سنجد.)
# ─────────────────────────────────────────────────────────────────────────────
diff --git a/.github/workflows/deploy-production.yml b/.github/workflows/deploy-production.yml
index 7f1780ae..730d341a 100644
--- a/.github/workflows/deploy-production.yml
+++ b/.github/workflows/deploy-production.yml
@@ -182,11 +182,13 @@ jobs:
           fail=1
           for i in 1 2 3 4 5; do
             ok=1
-            while IFS= read -r f; do
+            # FIX 2026-09-02: «<<< "$FILES"» کل فهرستِ فاصله‌دار را یک خط می‌خواند → sha1sum/curl روی نام بدشکل
+            # → این گیت از ۲۰۲۶-۰۸-۲۸ در هر ران (staging و production) بی‌قید‌وشرط شکست می‌خورد. نام فایل‌ها فاصله ندارند.
+            for f in $FILES; do
               want="$(sha1sum "$f" | cut -d' ' -f1)"
               got="$(curl -fsSL --max-time 30 "$BASE/$f?v=$(date +%s)" | sha1sum | cut -d' ' -f1)"
               if [ "$want" != "$got" ]; then ok=0; echo "   ≠ $f (want=${want:0:10} got=${got:0:10})"; fi
-            done <<< "$FILES"
+            done
             live_sw="$(curl -fsSL --max-time 30 "$BASE/crm/sw.js?v=$(date +%s)" | grep -o "RELEASE = 'v[0-9.]*'" | head -1)"
             if [ "$live_sw" != "RELEASE = '$PTF_CRM_RELEASE'" ]; then ok=0; echo "   ≠ crm/sw.js زنده: $live_sw"; fi
             if [ "$ok" -eq 1 ]; then fail=0; echo "✅ تلاش $i: همهٔ فایل‌های حساس زنده == کامیت"; break; fi
diff --git a/.github/workflows/deploy-staging.yml b/.github/workflows/deploy-staging.yml
index 62a0cac5..4adf2c6d 100644
--- a/.github/workflows/deploy-staging.yml
+++ b/.github/workflows/deploy-staging.yml
@@ -180,11 +180,13 @@ jobs:
           fail=1
           for i in 1 2 3 4 5; do
             ok=1
-            while IFS= read -r f; do
+            # FIX 2026-09-02: «<<< "$FILES"» کل فهرستِ فاصله‌دار را یک خط می‌خواند → sha1sum/curl روی نام بدشکل
+            # → این گیت از ۲۰۲۶-۰۸-۲۸ در هر ران (staging و production) بی‌قید‌وشرط شکست می‌خورد. نام فایل‌ها فاصله ندارند.
+            for f in $FILES; do
               want="$(sha1sum "$f" | cut -d' ' -f1)"
               got="$(curl -fsSL --max-time 30 "$BASE/$f?v=$(date +%s)" | sha1sum | cut -d' ' -f1)"
               if [ "$want" != "$got" ]; then ok=0; echo "   ≠ $f (want=${want:0:10} got=${got:0:10})"; fi
-            done <<< "$FILES"
+            done
             live_sw="$(curl -fsSL --max-time 30 "$BASE/crm/sw.js?v=$(date +%s)" | grep -o "RELEASE = 'v[0-9.]*'" | head -1)"
             if [ "$live_sw" != "RELEASE = '$PTF_CRM_RELEASE'" ]; then ok=0; echo "   ≠ crm/sw.js زنده: $live_sw"; fi
             live_idx="$(curl -fsSL --max-time 30 "$BASE/crm/index.html?v=$(date +%s)" | grep -c "v=${PTF_CRM_RELEASE#v}" || true)"
