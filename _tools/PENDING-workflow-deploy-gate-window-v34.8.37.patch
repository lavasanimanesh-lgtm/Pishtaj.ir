+            echo "   … تلاش $i ناموفق؛ ۳۰ ثانیه صبر و تکرار (پنجرهٔ کل ~۶ دقیقه — کش/پراپاگیشن هاست)"
+            sleep 30
           done
           if [ "$fail" -ne 0 ]; then
             echo "::error::سایت زنده با کامیت دیپلوی‌شده یکی نیست — استقرار ناموفق اعلام می‌شود"
