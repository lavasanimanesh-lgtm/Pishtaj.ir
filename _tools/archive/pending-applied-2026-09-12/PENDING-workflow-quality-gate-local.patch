diff --git a/.github/workflows/deploy-production.yml b/.github/workflows/deploy-production.yml
index 6817d26..3ba0964 100644
--- a/.github/workflows/deploy-production.yml
+++ b/.github/workflows/deploy-production.yml
@@ -35,7 +35,45 @@ permissions:
   contents: write        # لازم برای ساخت تگ و Release
 
 jobs:
+  quality:
+    name: Quality gate before production FTP
+    runs-on: ubuntu-latest
+    timeout-minutes: 12
+    steps:
+      - name: Verify confirmation
+        run: |
+          if [ "${{ github.event.inputs.confirm }}" != "DEPLOY" ]; then
+            echo "::error::تایید نشد. باید عبارت DEPLOY وارد شود."
+            exit 1
+          fi
+
+      - name: Checkout target ref
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.inputs.ref }}
+
+      - name: Set up PHP
+        uses: shivammathur/setup-php@v2
+        with:
+          php-version: '8.2'
+          coverage: none
+
+      - name: Lint PHP (api/ + crm/)
+        run: find api crm -type f -name '*.php' -print0 | xargs -0 -r -n1 php -l
+
+      - name: Set up Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Check JavaScript syntax (first-party CRM code)
+        run: find crm api -type f -name '*.js' -not -name '*.min.js' -print0 | xargs -0 -r -n1 node --check
+
+      - name: Focused UAT gate (sync, finance, notifications, security)
+        run: node _tools/uat/run-ci-gate.js
+
   deploy:
+    needs: quality
     runs-on: ubuntu-latest
     steps:
       - name: Verify confirmation
@@ -105,6 +143,8 @@ jobs:
             docs-deploy/**
             tester*.js
